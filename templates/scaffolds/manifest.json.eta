{
  "version": "<%= it.version %>",
  "short_name": "<%= it.name %>",
  "name": "<%= it.name %>",
  "manifest_version": 3,
  "action": {
    "default_popup": "browser-ext.html",
    "default_title": "<%= it.name %>"
  },
  "externally_connectable": {
    "matches": ["https://*/*"]
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [],
  "web_accessible_resources": [
    {
      "resources": ["*.*"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ]
}

