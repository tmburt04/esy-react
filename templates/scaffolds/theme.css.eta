@tailwind base;
@tailwind utilities;

:root {
  --color-primary: #3b82f6;
  --color-primary-dark: #2563eb;
  --color-secondary: #64748b;
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-error: #ef4444;
  --color-background: #f8fafc;
  --color-surface: #ffffff;
  --color-text: #0f172a;
  --color-text-muted: #64748b;
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
}

#<%= it.projectName %>-root {
  @apply fixed inset-0 block m-0 p-0 overflow-auto;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--color-background);
  color: var(--color-text);
}

/* Base element styles */
h1, h2, h3, h4, h5, h6 {
  @apply font-bold leading-tight;
}

a {
  color: var(--color-primary);
  text-decoration: none;
}

a:hover {
  color: var(--color-primary-dark);
  text-decoration: underline;
}

button, .btn {
  @apply px-4 py-2 rounded-md font-medium transition-colors cursor-pointer;
  background-color: var(--color-primary);
  color: white;
  border: none;
}

button:hover, .btn:hover {
  background-color: var(--color-primary-dark);
}

button:disabled, .btn:disabled {
  @apply opacity-50 cursor-not-allowed;
}

input, textarea, select {
  @apply px-3 py-2 border border-gray-300 rounded-md w-full;
  background-color: var(--color-surface);
}

input:focus, textarea:focus, select:focus {
  @apply outline-none ring-2 ring-blue-500 border-transparent;
}
